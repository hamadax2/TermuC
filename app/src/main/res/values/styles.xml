<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#007ACC</item>
        <item name="android:actionBarStyle">@style/VsActionBarLight</item>
        <item name="android:navigationBarColor">#F3F3F3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F3F3F3</item>
    </style>

    <style name="AppThemeDark" parent="@android:style/Theme.Material">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#007ACC</item>
        <item name="android:actionBarStyle">@style/VsActionBarDark</item>
        <item name="android:navigationBarColor">#181818</item>
        <item name="android:statusBarColor">#181818</item>
    </style>

    <style name="AppThemeDayNight" parent="AppTheme"/>

    <style name="VsActionBarDark" parent="@android:style/Widget.Material.ActionBar.Solid">
        <item name="android:background">#181818</item>
        <item name="android:titleTextStyle">@style/VsActionTitleDark</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="VsActionBarLight" parent="@android:style/Widget.Material.ActionBar.Solid">
        <item name="android:background">#FFFFFF</item>
        <item name="android:titleTextStyle">@style/VsActionTitleLight</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="VsActionTitleDark" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">#CCCCCC</item>
    </style>
    <style name="VsActionTitleLight" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">#333333</item>
    </style>

    <style name="keyBar">
        <item name="android:textViewStyle">@style/keyText</item>
    </style>
    <style name="keyText">
        <item name="android:clickable">true</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">@dimen/key_padding_vert</item>
        <item name="android:paddingBottom">@dimen/key_padding_vert</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textSize">@dimen/key_size</item>
        <item name="android:onClick">inputKey</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
    <style name="actionButton" parent="@android:style/Widget.Material.ActionButton">
        <item name="android:minWidth">44dp</item>
    </style>
    <style name="ctrlButton" parent="actionButton">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">24dp</item>
    </style>
</resources>